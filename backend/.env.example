# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/issue_tracker

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Initial Administrator Seed Account
ADMIN_NAME=YourAdminName
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_password_here
