# Frontend Environment Variables
# In production on Vercel, set this to your live Render backend API URL:
# Example: VITE_API_URL=https://your-backend-app.onrender.com/api
# In local development, leave unset to automatically use the Vite dev proxy (/api -> http://localhost:5001)
VITE_API_URL=https://issue-tracking-system-ten.vercel.app
